---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { ContactForm } from "@/components/contact/ContactForm";

// Scaffold placeholder: full home page content (hero, services, offices, FAQ,
// etc. per DESIGN.md §6) remains out of scope for this change and will be
// built incrementally in later work — this page still only proves the Astro
// + Tailwind + SSR-adapter scaffold builds and renders. The only addition in
// this PR is the reusable contact section (design rev.2: "mounted ...
// embedded inside src/pages/index.astro's id=\"contacto\" section").
---

<BaseLayout title="ALBA Abogacía & Consulting">
  <main class="mx-auto max-w-3xl px-4 py-16">
    <h1 class="font-heading text-4xl text-brand-brown">ALBA Abogacía &amp; Consulting</h1>
    <p class="mt-4 text-ink">Sitio en construcción.</p>
  </main>

  <section id="contacto" class="mx-auto max-w-3xl px-4 py-16">
    <ContactForm client:idle />
  </section>
</BaseLayout>
