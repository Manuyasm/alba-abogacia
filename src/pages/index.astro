---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { ContactForm } from "@/components/contact/ContactForm";
import Hero from "@/components/home/Hero.astro";
import ServicesSummary from "@/components/home/ServicesSummary.astro";
import TeamTeaser from "@/components/home/TeamTeaser.astro";
import ProcessSteps from "@/components/common/ProcessSteps.astro";
import OfficeCard from "@/components/common/OfficeCard.astro";
import FaqAccordion from "@/components/common/FaqAccordion.astro";
import SectionHeading from "@/components/common/SectionHeading.astro";
import { OFFICES, SITE_NAME } from "@/lib/site-facts";

// Spec: full Home page composition ("Hero Section" through "Contact
// Section", "Content Integrity", "Accessibility and Motion"). Design:
// `index.astro` is a thin composition root — `Hero`/`ServicesSummary`/
// `TeamTeaser`/`ProcessSteps` (built and tested in PR1/PR2) plus inline
// Offices/FAQ/contact-heading sections, in this exact order. Replaces the
// PR1 placeholder scaffold entirely.
const HOME_DESCRIPTION =
  "Despacho de abogacía y consultoría en Langreo (Asturias) y Madrid: derecho de familia, laboral, herencias, contratos y consultoría financiera, con un trato cercano.";

// FAQ copy: structural facts only (coverage area, how to request a
// consultation, documentation guidance, combined jurídico+financiero scope) —
// sourced from confirmed facts in `site-facts.ts` and the firm's actual
// service scope. Excludes pricing, response-time promises, a no-cost-visit
// claim (AGENTS.md §18), any bar-association credential number, and any
// WhatsApp reference.

const FAQ_ITEMS = [
  {
    question: "¿En qué zonas atienden?",
    answer:
      "Atendemos en Langreo (Asturias) y Madrid, tanto de forma presencial en nuestras oficinas como mediante consulta telemática.",
  },
  {
    question: "¿Cómo puedo solicitar una consulta?",
    answer:
      "Puede solicitar una consulta a través del formulario de contacto de esta web, por teléfono o por correo electrónico; nos pondremos en contacto con usted para concretar los siguientes pasos.",
  },
  {
    question: "¿Qué documentación necesito aportar?",
    answer:
      "La documentación necesaria depende de cada caso; en la primera toma de contacto le indicaremos qué documentos aportar según su situación.",
  },
  {
    question: "¿Atienden tanto asuntos jurídicos como financieros?",
    answer:
      "Sí, combinamos asesoramiento jurídico y consultoría financiera para ofrecer una atención conjunta cuando el caso lo requiere.",
  },
];
---

<BaseLayout title={SITE_NAME} description={HOME_DESCRIPTION}>
  <main id="main-content">
    <Hero />
    <ServicesSummary />
    <TeamTeaser />
    <ProcessSteps />

    <section class="mx-auto max-w-6xl px-4 py-16" data-reveal="fade-up">
      <SectionHeading>Nuestras oficinas</SectionHeading>
      <ul class="mt-8 grid gap-6 sm:grid-cols-2">
        <li data-reveal="stagger" style="--reveal-delay:0ms"><OfficeCard {...OFFICES.langreo} /></li>
        <li data-reveal="stagger" style="--reveal-delay:70ms"><OfficeCard {...OFFICES.madrid} /></li>
      </ul>
    </section>

    <section class="mx-auto max-w-3xl px-4 py-16">
      <SectionHeading>Preguntas frecuentes</SectionHeading>
      <!-- FaqAccordion already wraps itself in its own `data-reveal` div —
           no `data-reveal` is added here to avoid double-nesting it. -->
      <div class="mt-8">
        <FaqAccordion items={FAQ_ITEMS} />
      </div>
    </section>

    <section id="contacto" class="mx-auto max-w-3xl px-4 py-16" data-reveal="fade-up">
      <SectionHeading>Solicite su consulta</SectionHeading>
      <p class="mt-4 text-muted">
        Cuéntenos su situación a través del siguiente formulario y nos pondremos en contacto con usted.
      </p>
      <div class="mt-8">
        <ContactForm client:idle />
      </div>
    </section>
  </main>
</BaseLayout>
