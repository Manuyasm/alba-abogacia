---
import { Image } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ServiceDetailCard from "@/components/common/ServiceDetailCard.astro";
import ProcessSteps from "@/components/common/ProcessSteps.astro";
import FaqAccordion from "@/components/common/FaqAccordion.astro";
import { SITE_NAME } from "@/lib/site-facts";
// Icon-only crop of the real client logo's symbol — decorative, precedes
// the main <h1> (see Hero.astro's identical rationale comment).
import logoIcon from "@/assets/brand/logo-icon.png";

const SERVICIOS_DESCRIPTION =
  "Servicios de asesoría legal y consultoría financiera.";

interface ServiceDetail {
  title: string;
  description: string;
  ctaLabel: string;
  ctaHref: string;
}

const JURIDICO: ServiceDetail[] = [
  {
    title: "Litigios y Disputas",
    description: "Representación en tribunales y resolución de conflictos para proteger sus intereses.",
    ctaLabel: "Solicitar consulta",
    ctaHref: "/contacto",
  },
  {
    title: "Derecho Corporativo",
    description: "Asesoramiento en la formación, gobernanza y operación de empresas para asegurar el cumplimiento y la eficiencia.",
    ctaLabel: "Solicitar consulta",
    ctaHref: "/contacto",
  },
  {
    title: "Derecho de familia y menores",
    description: "Orientación en procesos de conflicto familiar, menores, régimen económico del matrimonio.",
    ctaLabel: "Solicitar consulta",
    ctaHref: "/contacto",
  },
  {
    title: "Derecho Laboral",
    description: "Asistencia en asuntos laborales, incluyendo negociaciones contractuales y resolución de disputas laborales.",
    ctaLabel: "Solicitar consulta",
    ctaHref: "/contacto",
  },
  {
    title: "Derecho hereditario",
    description: "Tramitación completa de herencias, incluyendo impuestos y actos notariales.",
    ctaLabel: "Solicitar consulta",
    ctaHref: "/contacto",
  },
];

const FINANCIERO: ServiceDetail[] = [
  {
    title: "Planificación financiera",
    description: "Desarrollo de estrategias financieras a corto y largo plazo para asegurar la estabilidad y el crecimiento.",
    ctaLabel: "Solicitar consulta",
    ctaHref: "/contacto",
  },
  {
    title: "Gestión de Riesgos",
    description: "Identificación y mitigación de riesgos financieros para proteger su patrimonio.",
    ctaLabel: "Solicitar consulta",
    ctaHref: "/contacto",
  },
  {
    title: "Asesoría en Inversiones",
    description: "Orientación en la selección y gestión de inversiones para maximizar rendimientos.",
    ctaLabel: "Solicitar consulta",
    ctaHref: "/contacto",
  },
  {
    title: "Reestructuración Financiera",
    description: "Asistencia en la reorganización de estructuras financieras para mejorar la eficiencia y la rentabilidad.",
    ctaLabel: "Solicitar consulta",
    ctaHref: "/contacto",
  },
  {
    title: "Análisis de Viabilidad de Proyectos",
    description: "Evaluación de proyectos de inversión para asegurar su viabilidad y rentabilidad.",
    ctaLabel: "Solicitar consulta",
    ctaHref: "/contacto",
  },
];

// FAQ copy: fresh, structural facts only (scope differentiation,
// litigation-vs-non-litigation, service combination, remote availability) —
// written for this page, not derived from any mockup. Excludes pricing,
// response-time promises, "consulta gratuita", any credential number, and any
// WhatsApp reference.
const FAQ_ITEMS = [
  {
    question: "¿Qué diferencia hay entre un asunto jurídico y uno financiero?",
    answer:
      "Un asunto jurídico implica una cuestión legal, como una separación, una herencia o una reclamación laboral, mientras que la consultoría financiera se centra en la planificación y el análisis de su situación económica. En muchos casos ambos aspectos están relacionados y los abordamos de forma conjunta.",
  },
  {
    question: "¿Es necesario acudir a juicio para resolver mi situación?",
    answer:
      "No siempre. Muchos asuntos se resuelven mediante acuerdo, mediación o negociación con la otra parte, sin necesidad de un procedimiento judicial. En la primera toma de contacto valoramos qué vía es más adecuada para su caso.",
  },
  {
    question: "¿Puedo combinar varios servicios si mi situación lo requiere?",
    answer:
      "Sí. Es habitual que un mismo asunto tenga implicaciones jurídicas y financieras a la vez, por ejemplo en herencias o separaciones, y coordinamos ambos servicios para ofrecerle una atención conjunta.",
  },
  {
    question: "¿Puedo recibir asesoramiento de forma telemática?",
    answer:
      "Sí, atendemos tanto de forma presencial en nuestras oficinas de Langreo (Asturias) y Madrid como mediante consulta telemática, según le resulte más cómodo.",
  },
];

// Button classes follow DESIGN.md §7.1 (same primary-CTA treatment as
// `Hero.astro`'s "Contactar" button): red background/white text, 44px
// minimum tap height, hover/focus-visible states.
const primaryCtaClasses =
  "inline-flex min-h-[44px] items-center justify-center rounded-md bg-brand-red px-6 py-2 text-sm font-semibold text-paper transition-interactive motion-reduce:transition-none hover:bg-brand-red-dark focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-red";

const jumpLinkClasses =
  "text-sm font-semibold text-brand-red underline underline-offset-4 transition-interactive motion-reduce:transition-none hover:text-brand-red-dark focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-red";
---

<BaseLayout title={`Servicios | ${SITE_NAME}`} description={SERVICIOS_DESCRIPTION}>
  <main id="main-content" class="overflow-x-hidden">
    <section class="mx-auto max-w-6xl px-4 py-16" data-reveal="fade-up">
      <div class="flex items-center gap-3">
        <Image src={logoIcon} alt="" class="h-10 w-10 shrink-0 sm:h-12 sm:w-12" widths={[40, 48]} />
        <h1 class="font-heading text-4xl font-semibold text-brand-brown sm:text-5xl">
          Servicios jurídicos y de consultoría financiera
        </h1>
      </div>
      <p class="mt-4 max-w-2xl text-lg text-muted">
        En Alba Abogacía &amp; Consulting combinamos asesoramiento jurídico y consultoría financiera para
        acompañarle en cada etapa de su situación, ya sea personal o empresarial.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <a href="#area-juridica" class={jumpLinkClasses}>Asesoría legal</a>
        <a href="#area-financiera" class={jumpLinkClasses}>Consultoría financiera</a>
      </div>
    </section>

    <section id="area-juridica" class="mx-auto max-w-6xl px-4 py-16" data-reveal="fade-left">
      <h2 class="font-heading text-3xl font-semibold text-brand-brown">Asesoría legal</h2>
      <p class="mt-4 max-w-2xl text-muted">
        Nuestro equipo de abogados expertos está dedicado a proporcionar soluciones legales efectivas y personalizadas para una variedad de necesidades.
      </p>
      <ul class="mt-8 grid gap-6 sm:grid-cols-2">
        {
          JURIDICO.map((service) => (
            <ServiceDetailCard
              title={service.title}
              description={service.description}
              ctaLabel={service.ctaLabel}
              ctaHref={service.ctaHref}
            />
          ))
        }
      </ul>
    </section>

    <section id="area-financiera" class="mx-auto max-w-6xl px-4 py-16" data-reveal="fade-right">
      <h2 class="font-heading text-3xl font-semibold text-brand-brown">Consultoría financiera</h2>
      <p class="mt-4 max-w-2xl text-muted">
        Ofrecemos servicios de consultoría financiera para ayudarle a gestionar sus recursos de manera eficiente y alcanzar sus objetivos financieros.
      </p>
      <ul class="mt-8 grid gap-6 sm:grid-cols-2">
        {
          FINANCIERO.map((service) => (
            <ServiceDetailCard
              title={service.title}
              description={service.description}
              ctaLabel={service.ctaLabel}
              ctaHref={service.ctaHref}
            />
          ))
        }
      </ul>
    </section>

    <ProcessSteps />

    <section class="mx-auto max-w-3xl px-4 py-16">
      <h2 class="font-heading text-3xl font-semibold text-brand-brown">Preguntas frecuentes</h2>
      <!-- FaqAccordion already wraps itself in its own `data-reveal` div —
           no `data-reveal` is added here to avoid double-nesting it. -->
      <div class="mt-8">
        <FaqAccordion items={FAQ_ITEMS} />
      </div>
    </section>

    <section class="mx-auto max-w-3xl px-4 py-16" data-reveal="fade-up">
      <h2 class="font-heading text-3xl font-semibold text-brand-brown">¿Necesita asesoramiento?</h2>
      <p class="mt-4 text-muted">
        Cuéntenos su situación y le indicaremos cómo podemos ayudarle, tanto en el ámbito jurídico como en el
        financiero.
      </p>
      <div class="mt-8">
        <a href="/contacto" class={primaryCtaClasses} data-track="appointment_click">Solicitar consulta</a>
      </div>
    </section>
  </main>
</BaseLayout>
