---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { ContactForm } from "@/components/contact/ContactForm";

// Office address/phone confirmed by the client 2026-09-10 (chat). Colegiada
// number remains an unconfirmed client fact — named placeholder only.
// Madrid office (C/ Bravo Murillo, nº 377, 2º, Madrid) is also confirmed but
// not yet shown on this page — this page currently only renders one office
// block; adding the second office is a page-content scope decision, not a
// mechanical placeholder fill, left for a future change.
const OFFICE_ADDRESS_LANGREO = "C/ Inventor La Cierva, nº 22, 1º A, C.P. 33930, Langreo, Principado de Asturias";
const OFFICE_PHONE = "985694493";
const COLEGIADA_NUMBER = "{{COLEGIADA_NUMBER}}";
---

<BaseLayout title="Contacto — ALBA Abogacía & Consulting">
  <main class="mx-auto max-w-3xl px-4 py-16">
    <ContactForm client:idle />

    <address class="mt-12 border-t border-border pt-8 text-sm not-italic text-muted">
      <p>{OFFICE_ADDRESS_LANGREO}</p>
      <p class="mt-1">
        Teléfono:
        <a href={`tel:${OFFICE_PHONE}`} class="font-medium text-brand-red underline underline-offset-2">
          {OFFICE_PHONE}
        </a>
      </p>
      <p class="mt-1">Colegiada n.º {COLEGIADA_NUMBER}</p>
    </address>
  </main>
</BaseLayout>
