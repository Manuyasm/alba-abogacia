---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { ContactForm } from "@/components/contact/ContactForm";
import { OFFICES } from "@/lib/site-facts";

// Langreo office address/phone are now sourced from `site-facts.ts` (single
// source of truth, per design's "Contact-fact storage" decision) instead of
// page-local constants — this page was the reason that module was created in
// the first place. Colegiada number remains an unconfirmed client fact — a
// named placeholder only, and stays page-local since it isn't a site-wide
// fact in `site-facts.ts`. Madrid office (`OFFICES.madrid`) is also confirmed
// but not yet shown on this page — adding the second office is a
// page-content scope decision, not a mechanical placeholder fill, left for a
// future change.
const langreo = OFFICES.langreo;
const COLEGIADA_NUMBER = "{{COLEGIADA_NUMBER}}";
---

<BaseLayout title="Contacto — ALBA Abogacía & Consulting">
  <main id="main-content" class="mx-auto max-w-3xl px-4 py-16">
    <div data-reveal="fade-up">
      <ContactForm client:idle />
    </div>

    <address class="mt-12 border-t border-border pt-8 text-sm not-italic text-muted" data-reveal="fade-up">
      <p>{langreo.addressLines[0]}</p>
      <p class="mt-1">
        Teléfono:
        <a
          href={langreo.phoneHref}
          class="font-medium text-brand-red underline underline-offset-2 transition-interactive motion-reduce:transition-none hover:text-brand-red-dark focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-red"
          data-track="phone_click"
        >
          {langreo.phone}
        </a>
      </p>
      <p class="mt-1">Colegiada n.º {COLEGIADA_NUMBER}</p>
    </address>
  </main>
</BaseLayout>
