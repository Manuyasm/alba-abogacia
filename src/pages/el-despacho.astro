---
import BaseLayout from "@/layouts/BaseLayout.astro";
import TeamCard from "@/components/common/TeamCard.astro";
import OfficeCard from "@/components/common/OfficeCard.astro";
import FaqAccordion from "@/components/common/FaqAccordion.astro";
import { OfficeMap } from "@/components/common/OfficeMap";
import { OFFICES, SITE_NAME } from "@/lib/site-facts";

// Spec: "Page Existence", "Philosophy/Intro Section", "Team Profiles",
// "Offices Section", "El Despacho FAQ", "Closing CTA", "No Garantías/
// Credential-Status Section", "Content Integrity (No Fabricated Claims)",
// "Accessibility and Navigation State". Design: flat static page reusing
// `TeamCard`/`OfficeCard`/`FaqAccordion` exactly as shipped — `bio` is now
// populated on `TeamCard` for the first time, and `mapNote` is populated on
// `OfficeCard` with identical text on both offices (non-hierarchical by
// construction). No `<ProcessSteps />` on this page (design's deliberate
// omission — already covered on Home/Servicios). No "Garantías" section in
// any form — explicitly declined by the client, enforced by
// `_el-despacho-content-integrity.test.ts`.
const EL_DESPACHO_DESCRIPTION =
  "Conozca al equipo de Alba Abogacía & Consulting y nuestras oficinas en Langreo (Asturias) y Madrid: asesoramiento jurídico y consultoría financiera con trato cercano.";

// Team (§2): names/roles verbatim-identical to `TeamTeaser.astro`'s `TEAM`
// array (Service/Team Taxonomy Consistency) — `bio` is new to this page.
const TEAM = [
  {
    name: "Verónica Alba Suárez",
    role: "Abogada",
    bio: "Atiende los asuntos jurídicos del despacho, acompañando a cada persona con explicaciones claras sobre su situación y los pasos disponibles.",
  },
  {
    name: "Aitor Domínguez López",
    role: "Consultor financiero",
    bio: "Se ocupa de la consultoría financiera del despacho, ayudando a particulares y empresas a organizar su situación económica antes de tomar decisiones importantes. Trabaja de forma coordinada con el área jurídica cuando un mismo asunto lo requiere.",
  },
];

// Offices (§3): sourced from `site-facts.ts`'s `OFFICES` verbatim. Identical
// `mapNote` text on both cards by construction — no "sede principal"/"sede
// corporativa" hierarchy framing between Langreo and Madrid.
const OFFICE_MAP_NOTE = "Atención presencial y telemática.";

// office-map-widget PR2 (task 3.3): one shared map for both offices, mounted
// below both `OfficeCard`s (design's page-mounting decision — not one map
// per card). Projected to `OfficeMapMarker`'s exact shape.
const OFFICE_MAP_MARKERS = [OFFICES.langreo, OFFICES.madrid].map(({ name, lat, lon }) => ({
  name,
  lat,
  lon,
}));

// FAQ (§4): fresh, el-despacho-specific structural facts only (how the two
// professionals coordinate, remote/telemático availability, and a pointer to
// the real privacy-policy page — never an RGPD/confidentiality guarantee
// claim). Distinct from Home's and Servicios' FAQ question sets.
const FAQ_ITEMS = [
  {
    question: "¿Cómo trabajan juntos Verónica y Aitor cuando un caso tiene parte jurídica y financiera?",
    answer:
      "Cuando un mismo asunto tiene aspectos jurídicos y financieros, coordinamos ambas áreas para ofrecerle una visión conjunta, sin que tenga que gestionar el contacto con el despacho por separado según el tema.",
  },
  {
    question: "¿Puedo recibir atención en Langreo, en Madrid o de forma telemática?",
    answer:
      "Sí. Atendemos de forma presencial en nuestras oficinas de Langreo (Asturias) y Madrid, y también mediante consulta telemática si le resulta más cómodo.",
  },
  {
    question: "¿Cómo se trata la información que comparto con el despacho?",
    answer:
      "Tratamos su información con discreción y la utilizamos únicamente para atender su caso; puede consultar el detalle en nuestra página de política de privacidad.",
  },
  {
    question: "¿Necesito saber de antemano si mi asunto es jurídico o financiero?",
    answer:
      "No. Cuéntenos su situación y le indicaremos si corresponde al área jurídica, a la consultoría financiera o a ambas, y quién le atenderá.",
  },
];

// Button classes follow DESIGN.md §7.1 (same primary-CTA treatment as
// `servicios.astro`'s closing CTA).
const primaryCtaClasses =
  "inline-flex min-h-[44px] items-center justify-center rounded-md bg-brand-red px-6 py-2 text-sm font-semibold text-paper transition-interactive motion-reduce:transition-none hover:bg-brand-red-dark focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-red";
---

<BaseLayout title={`El despacho | ${SITE_NAME}`} description={EL_DESPACHO_DESCRIPTION}>
  <main id="main-content">
    <section class="mx-auto max-w-6xl px-4 py-16" data-reveal="fade-up">
      <h1 class="font-heading text-4xl font-semibold text-brand-brown sm:text-5xl">Quiénes somos</h1>
      <p class="mt-4 max-w-2xl text-lg text-muted">
        Alba Abogacía &amp; Consulting es un despacho que combina asesoramiento jurídico y consultoría
        financiera, con oficinas en Langreo (Asturias) y Madrid. Trabajamos para que cada persona entienda su
        situación con claridad y sepa en cada momento cuáles son los siguientes pasos.
      </p>
      <ul class="mt-8 grid gap-6 sm:grid-cols-2">
        <li>
          <p class="font-heading text-lg font-semibold text-ink">Claridad</p>
          <p class="mt-2 text-sm text-muted">
            Le explicamos su situación en un lenguaje comprensible, evitando tecnicismos innecesarios.
          </p>
        </li>
        <li>
          <p class="font-heading text-lg font-semibold text-ink">Confianza</p>
          <p class="mt-2 text-sm text-muted">
            Le contamos con honestidad qué opciones tiene y qué puede esperar, sin prometer resultados que no
            dependen de nosotros.
          </p>
        </li>
        <li>
          <p class="font-heading text-lg font-semibold text-ink">Cercanía</p>
          <p class="mt-2 text-sm text-muted">
            Le atendemos de forma personal y accesible, en Langreo, en Madrid o de manera telemática, según lo
            que le resulte más cómodo.
          </p>
        </li>
        <li>
          <p class="font-heading text-lg font-semibold text-ink">Privacidad</p>
          <p class="mt-2 text-sm text-muted">
            Tratamos su información con discreción y solo la utilizamos para lo necesario para atender su caso.
          </p>
        </li>
      </ul>
    </section>

    <section class="mx-auto max-w-6xl px-4 py-16" data-reveal="fade-up">
      <h2 class="font-heading text-3xl font-semibold text-brand-brown">El equipo</h2>
      <ul class="mt-8 grid gap-6 sm:grid-cols-2">
        {
          TEAM.map((member, index) => (
            <li data-reveal="stagger" style={`--reveal-delay:${index * 70}ms`}>
              <TeamCard name={member.name} role={member.role} bio={member.bio} />
            </li>
          ))
        }
      </ul>
    </section>

    <section class="mx-auto max-w-6xl px-4 py-16" data-reveal="fade-up">
      <h2 class="font-heading text-3xl font-semibold text-brand-brown">Dónde estamos</h2>
      <ul class="mt-8 grid gap-6 sm:grid-cols-2">
        <li data-reveal="stagger" style="--reveal-delay:0ms">
          <OfficeCard {...OFFICES.langreo} mapNote={OFFICE_MAP_NOTE} />
        </li>
        <li data-reveal="stagger" style="--reveal-delay:70ms">
          <OfficeCard {...OFFICES.madrid} mapNote={OFFICE_MAP_NOTE} />
        </li>
      </ul>
      <div class="mt-8">
        <OfficeMap client:visible offices={OFFICE_MAP_MARKERS} />
      </div>
    </section>

    <section class="mx-auto max-w-3xl px-4 py-16">
      <h2 class="font-heading text-3xl font-semibold text-brand-brown">Preguntas frecuentes</h2>
      <!-- FaqAccordion already wraps itself in its own `data-reveal` div —
           no `data-reveal` is added here to avoid double-nesting it. -->
      <div class="mt-8">
        <FaqAccordion items={FAQ_ITEMS} />
      </div>
    </section>

    <section class="mx-auto max-w-3xl px-4 py-16" data-reveal="fade-up">
      <h2 class="font-heading text-3xl font-semibold text-brand-brown">Hablemos de su situación</h2>
      <p class="mt-4 text-muted">
        Cuéntenos su situación a través del formulario de contacto y le indicaremos cómo podemos ayudarle.
      </p>
      <div class="mt-8">
        <a href="/contacto" class={primaryCtaClasses} data-track="appointment_click">Solicitar consulta</a>
      </div>
    </section>
  </main>
</BaseLayout>
