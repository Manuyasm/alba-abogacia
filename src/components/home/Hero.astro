---
// Spec: "Hero Section" — real Spanish headline/subheadline stating the
// firm's legal + financial-consulting value proposition, dual CTA
// (`#contacto` anchor + `/servicios` link), no fabricated stats or
// stock/placeholder imagery. Design: page-specific literal copy, no props
// (single consumer — `src/pages/index.astro` — not cross-page data like
// `site-facts.ts`). Button classes follow DESIGN.md §7.1: primary = red
// background/white text; secondary is now a light/paper-bordered outline
// (was brand-brown-bordered) since it sits on the dark photo overlay below,
// not the page's light background — both keep the 44px minimum tap height
// and hover/focus-visible states.
//
// PR C ("Comprehensive Motion System v2"): full-bleed banner layout (was
// two-column text/photo) with a load-triggered (not scroll-triggered)
// entrance sequence. The hero sits above the fold and is always visible on
// first paint, so it uses a plain CSS `animation` sequence
// (`.hero-stagger`/`.hero-photo` in global.css, MOTION-GUARDRAIL
// reveal-band) instead of the IntersectionObserver-driven `[data-reveal]`
// system used further down the page. Every element exists and is fully
// visible in the rendered HTML with no JS involved — the animation is a
// pure entrance flourish, not a visibility mechanism, and collapses via the
// existing global `prefers-reduced-motion` override.
// Photo: the real office banner image (client-provided, with the real logo
// overlaid) fills the section as a background — zoom scale(1.025)→scale(1)
// on load. A dark gradient scrim sits between the photo and the text
// (independent of the photo's own varying brightness) so the text stays
// readable — text-only WCAG AA contrast, verified against the scrim's own
// solid color, not the busy photo behind it.
import { Image } from "astro:assets";
import heroImage from "@/assets/brand/office.png";

const primaryCtaClasses =
  "btn-primary inline-flex min-h-[44px] items-center justify-center rounded-md bg-brand-red px-6 py-2 text-sm font-semibold text-paper transition-interactive motion-reduce:transition-none hover:bg-brand-red-dark focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-paper";

const secondaryCtaClasses =
  "inline-flex min-h-[44px] items-center justify-center rounded-md border border-paper bg-transparent px-6 py-2 text-sm font-semibold text-paper transition-interactive motion-reduce:transition-none hover:bg-paper/10 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-paper";
---

<section class="relative isolate overflow-hidden">
  <div class="absolute inset-0 -z-10">
    <Image
      src={heroImage}
      alt="Despacho de ALBA Abogacía & Consulting."
      class="hero-photo h-full w-full object-cover"
      widths={[640, 1280, 1920]}
    />
    <div class="absolute inset-0 bg-gradient-to-r from-ink/85 via-ink/70 to-ink/40"></div>
  </div>
  <div class="mx-auto max-w-6xl px-4 py-24 sm:py-32">
    <div class="hero-stagger flex max-w-2xl flex-col items-start">
      <h1 class="font-heading text-4xl font-semibold text-paper sm:text-5xl">
        Asesoramiento jurídico y financiero claro, en Asturias y Madrid
      </h1>
      <p class="mt-4 max-w-2xl text-lg text-cream" style="--hero-delay:150ms">
        En Alba Abogacía &amp; Consulting resolvemos cuestiones de familia, herencias, laboral y contratos, junto con
        consultoría financiera, con un trato cercano y explicaciones comprensibles.
      </p>
      <div class="mt-8 flex flex-wrap gap-4" style="--hero-delay:300ms">
        <a href="#contacto" class={primaryCtaClasses} data-track="appointment_click">Contactar</a>
        <a href="/servicios" class={secondaryCtaClasses}>Conocer los servicios</a>
      </div>
    </div>
  </div>
</section>
