---
// Spec: "Team Teaser" — a `TeamCard` per confirmed team member with name and
// generic role only (no bio), linking the teaser to `/el-despacho`. Design:
// page-specific literal copy, no props (single consumer, same rationale as
// `Hero.astro`/`ServicesSummary.astro`). Team names/roles (Verónica Alba
// Suárez — Abogada; Aitor Domínguez López — Asesor financiero) are
// explicitly user-authorized for this change — do not re-flag or defer.
// Photos: the same real headshots published on the current live site's
// "Sobre nosotros" page (legitimate content-migration source, AGENTS.md
// §2) — never a fabricated/stock photo. No `bio` prop is passed: omitting
// it keeps this teaser bio-free per spec.
import TeamCard from "@/components/common/TeamCard.astro";
import SectionHeading from "@/components/common/SectionHeading.astro";
import veronicaPhoto from "@/assets/team/veronica.jpg";
import aitorPhoto from "@/assets/team/aitor.jpg";

const TEAM = [
  { name: "Verónica Alba Suárez", role: "Abogada", photo: veronicaPhoto },
  { name: "Aitor Domínguez López", role: "Asesor financiero", photo: aitorPhoto },
];
---

<section class="mx-auto max-w-6xl px-4 py-16" data-reveal="fade-up">
  <SectionHeading>Quién le atiende</SectionHeading>
  <ul class="mt-8 grid gap-6 sm:grid-cols-2">
    {
      TEAM.map((member, index) => (
        <li data-reveal="stagger" style={`--reveal-delay:${index * 70}ms`}>
          <TeamCard
            name={member.name}
            role={member.role}
            photo={member.photo}
            photoAlt={`Fotografía de ${member.name}`}
          />
        </li>
      ))
    }
  </ul>
  <div class="mt-8">
    <a
      href="/el-despacho"
      class="font-semibold text-brand-red transition-interactive motion-reduce:transition-none hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-red"
    >
      Conocer al despacho
    </a>
  </div>
</section>
