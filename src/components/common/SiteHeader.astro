---
import { Image } from "astro:assets";
import { SITE_NAME } from "@/lib/site-facts";
// Real client logo, verified vertical lockup (symbol above wordmark,
// transparent background) — see AGENTS.md §14 / DESIGN.md §3.2, §7.3 for the
// `astro:assets` mandate (auto width/height avoids CLS, auto AVIF/WebP).
import logo from "@/assets/brand/logo.png";

// Structural route list, duplicated (not extracted into a shared module)
// in `SiteFooter.astro`: only 2 consumers, 4 static entries, low drift risk
// (route paths, not client-confirmed facts subject to change) — unlike
// `site-facts.ts`, which centralizes confirmed contact data with 3+
// consumers and real drift risk per the design doc's rationale.
const NAV_LINKS = [
  { href: "/", label: "Inicio" },
  { href: "/servicios", label: "Servicios" },
  { href: "/el-despacho", label: "El despacho" },
  { href: "/contacto", label: "Contacto" },
];

// Spec: "Site Navigation Header" — current page marked with
// `aria-current="page"`, trailing slashes normalized so "/servicios" and
// "/servicios/" both match (design's shared active-link helper).
const normalize = (path: string) => path.replace(/\/+$/, "") || "/";
const isActive = (href: string) => normalize(Astro.url.pathname) === normalize(href);

const linkClasses = (href: string) =>
  [
    "rounded-md px-1 py-1 text-sm font-medium transition-interactive motion-reduce:transition-none",
    "hover:text-brand-red focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-red",
    isActive(href) ? "text-brand-red underline underline-offset-4" : "text-ink",
  ].join(" ");

// Design decision #7 (animations-v2, "Header compaction") — persistent
// desktop CTA, copy reused verbatim from the existing `/servicios` and
// `/el-despacho` closing CTAs. Hidden on mobile: the hamburger disclosure
// below already exposes every nav destination, including Contacto.
const primaryCtaClasses =
  "hidden md:inline-flex min-h-[44px] items-center justify-center rounded-md bg-brand-red px-5 py-2 text-sm font-semibold text-paper transition-interactive motion-reduce:transition-none hover:bg-brand-red-dark focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-red";
---

<header class="site-header border-b border-border bg-paper" data-header>
  <div class="site-header-bar mx-auto flex max-w-6xl items-center justify-between gap-4 px-4">
    <!-- Narrow ClientRouter adoption (spec: "Header stays stable during
         transition"; PR F). `transition:persist` is scoped to only this
         logo link, deliberately NOT the whole `<header>`: persisting the
         entire header would keep the OLD page's server-rendered nav
         `aria-current`/active-link state and the OLD "Solicitar consulta"
         CTA node alive across navigation, which would (a) leave the active
         nav link visibly stale after navigating, and (b) risk two click
         listeners ending up bound to the exact same never-replaced CTA
         node, firing `appointment_click` twice per click. Persisting only
         the logo removes any visible flash/reset of the one element the
         requirement is actually about, while nav/CTA still re-render fresh
         (and re-observe fresh) on every navigation. -->
    <a
      href="/"
      class="flex items-center rounded-md transition-interactive motion-reduce:transition-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-red"
      transition:name="site-logo"
      transition:persist
    >
      <Image src={logo} alt={SITE_NAME} class="h-10 w-auto" widths={[80, 160]} />
    </a>

    <nav aria-label="Principal" class="hidden md:flex md:items-center md:gap-6">
      {
        NAV_LINKS.map((link) => (
          <a href={link.href} aria-current={isActive(link.href) ? "page" : undefined} class={linkClasses(link.href)}>
            {link.label}
          </a>
        ))
      }
    </nav>

    <a href="/contacto" class={primaryCtaClasses} data-track="appointment_click">Solicitar consulta</a>

    <details class="md:hidden">
      <summary
        class="list-none cursor-pointer rounded-md p-2 transition-interactive motion-reduce:transition-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-red"
        aria-label="Abrir menú"
      >
        <span aria-hidden="true">☰</span>
      </summary>
      <nav aria-label="Principal (móvil)" class="mt-2 flex flex-col gap-3 pb-4">
        {
          NAV_LINKS.map((link) => (
            <a href={link.href} aria-current={isActive(link.href) ? "page" : undefined} class={linkClasses(link.href)}>
              {link.label}
            </a>
          ))
        }
      </nav>
    </details>
  </div>
</header>
