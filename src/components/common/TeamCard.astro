---
// Spec: "TeamCard Component" — renders a name and role with an appropriate
// heading level for the name. `photo` is optional: when omitted (no real
// photo confirmed for that person), it falls back to a safe initials
// placeholder with no broken <img>/missing alt text — never a fabricated
// stock photo. When supplied, `photoAlt` is required alongside it so the
// real photo always gets a real accessible name.
import { Image } from "astro:assets";

interface Props {
  name: string;
  role: string;
  bio?: string;
  photo?: ImageMetadata;
  photoAlt?: string;
}

const { name, role, bio, photo, photoAlt } = Astro.props;

const initials = name
  .split(/\s+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((word) => word[0]?.toUpperCase() ?? "")
  .join("");
---

<div class="flex flex-col gap-3 rounded-lg border border-border bg-paper p-6">
  {
    photo ? (
      <Image src={photo} alt={photoAlt ?? name} class="h-16 w-16 rounded-full object-cover" width={64} height={64} />
    ) : (
      <span
        aria-hidden="true"
        class="flex h-16 w-16 items-center justify-center rounded-full bg-cream-deep font-heading text-lg font-semibold text-brand-brown"
      >
        {initials}
      </span>
    )
  }
  <h3 class="font-heading text-lg font-semibold text-ink">{name}</h3>
  <p class="text-sm font-medium text-muted">{role}</p>
  {bio && <p class="text-sm text-muted">{bio}</p>}
</div>
