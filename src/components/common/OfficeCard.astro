---
// Spec: "OfficeCard Component" — renders address, phone, and email from
// props, supporting either office (Langreo or Madrid) without hardcoding
// either one's data. Props intentionally mirror `site-facts.ts`'s
// `OfficeFact` shape (`addressLines`/`phone`/`phoneHref`/`email`/`lat`/`lon`)
// so a consumer can pass `OFFICES.langreo`/`OFFICES.madrid` directly —
// Madrid has no confirmed phone or email, so both remain optional and are
// simply omitted from the rendered markup when absent (never a fabricated
// value).
// office-map: also renders a "Cómo llegar" outbound link to Google Maps,
// built at build time from `name`/`addressLines` — no request is made until
// the visitor activates the link.
// office-map-per-office redesign: also mounts its own small `OfficeMap`
// instance below the address/contact/directions content, centered on this
// card's own `lat`/`lon` — replacing the previous single shared map mounted
// once per page below every card.
import { OfficeMap } from "./OfficeMap";

interface Props {
  name: string;
  addressLines: string[];
  phone?: string;
  phoneHref?: string;
  email?: string;
  lat: number;
  lon: number;
  mapNote?: string;
}

const { name, addressLines, phone, phoneHref, email, lat, lon, mapNote } = Astro.props;

const linkClasses =
  "font-medium text-brand-red underline underline-offset-2 transition-interactive motion-reduce:transition-none hover:text-brand-red-dark focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-red";

const mapsHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
  [name, ...addressLines].join(", "),
)}`;
---

<div class="rounded-lg border border-border bg-paper p-6">
  <p class="font-heading text-lg font-semibold text-ink">{name}</p>
  <address class="mt-3 text-sm not-italic text-muted">
    {addressLines.map((line) => <p>{line}</p>)}
    {phone && (
      <p class="mt-1">
        Teléfono:{" "}
        <a href={phoneHref ?? `tel:${phone}`} class={linkClasses} data-track="phone_click">
          {phone}
        </a>
      </p>
    )}
    {email && (
      <p class="mt-1">
        Email:{" "}
        <a href={`mailto:${email}`} class={linkClasses} data-track="email_click">
          {email}
        </a>
      </p>
    )}
    <p class="mt-2">
      <a
        href={mapsHref}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Cómo llegar a ${name}`}
        class="arrow-link transition-interactive motion-reduce:transition-none inline-flex w-fit items-center gap-1.5 font-semibold text-brand-red focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-red"
      >
        Cómo llegar
        <span aria-hidden="true" class="arrow-link-arrow">→</span>
      </a>
    </p>
  </address>
  {mapNote && <p class="mt-3 text-xs text-muted">{mapNote}</p>}
  <div class="mt-4">
    <OfficeMap client:visible name={name} lat={lat} lon={lon} />
  </div>
</div>
