---
import "@/styles/global.css";
import { ClientRouter } from "astro:transitions";
import { BRAND_NAME, OFFICES, PRIMARY_EMAIL } from "@/lib/site-facts";
import SiteHeader from "@/components/common/SiteHeader.astro";
import SiteFooter from "@/components/common/SiteFooter.astro";

interface Props {
  title: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  noindex?: boolean;
}

// Site-wide default meta description (spec: "Per-Page Meta Tags" — "Default
// applies" scenario). Describes only the firm's real practice areas per
// `sdd-init/alba-abogacia` (family law, labor law, inheritance, financial
// consulting) — no unconfirmed marketing claims (e.g. "free consultation",
// years of experience).
const DEFAULT_DESCRIPTION =
  "Despacho de abogacía y consultoría en Langreo (Asturias) y Madrid, especializado en derecho de familia, derecho laboral, herencias y asesoramiento a empresas.";

const {
  title,
  description = DEFAULT_DESCRIPTION,
  canonicalUrl = Astro.url.href,
  ogImage,
  noindex = false,
} = Astro.props;

// Organization/LegalService JSON-LD (spec: "Organization/LegalService
// JSON-LD"). Only confirmed fields from `site-facts.ts` are encoded — never
// a legal-entity name (`legalName` is intentionally never set; the legal
// entity name stays an unconfirmed page-local placeholder in
// `politica-privacidad.astro`), never a `{{PLACEHOLDER}}` token, never
// experience/credential claims. `telephone` uses only the Langreo office's
// confirmed number; Madrid's phone/email are unconfirmed and simply never
// referenced here (not filtered out — never fabricated in the first place).
const organizationJsonLd = {
  "@context": "https://schema.org",
  "@type": "LegalService",
  name: BRAND_NAME,
  email: PRIMARY_EMAIL,
  telephone: OFFICES.langreo.phone,
  address: [OFFICES.langreo, OFFICES.madrid].map((office) => ({
    "@type": "PostalAddress",
    streetAddress: office.addressLines.join(", "),
    addressCountry: "ES",
  })),
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Cropped from the real client logo's icon mark (src/assets/brand/logo.png)
         — the wordmark below it is illegible at favicon size, so only the
         symbol is used here. -->
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} />
    <!-- Narrow ClientRouter adoption (spec: "Narrow ClientRouter Adoption";
         design decision #9). Native View Transitions for document
         navigation only — this project stays a static multi-page site, not
         a full SPA; see `src/lib/motion/*`'s `astro:page-load` re-init
         wiring below and `SiteHeader.astro`'s `transition:persist` logo. -->
    <ClientRouter />
  </head>
  <body>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-brand-red focus:px-4 focus:py-2 focus:text-paper transition-interactive motion-reduce:transition-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-red"
    >
      Saltar al contenido
    </a>
    <SiteHeader />
    <slot />
    <SiteFooter />
    <script>
      import { initScrollReveal } from "@/lib/motion/scroll-reveal";
      import { initHeaderScroll } from "@/lib/motion/header-scroll";
      import { initFaqAnimation } from "@/lib/motion/faq-animate";
      import { initClickTracking } from "@/lib/analytics/click-tracking";

      // Design decision #9 ("ClientRouter re-init"): this is now the SOLE
      // place that ever calls these four `init*` functions — each module's
      // own former self-invoking auto-init-on-import block was removed in
      // PR F, because `astro:page-load` fires on BOTH the very first page
      // load (via the native `window` `load` event, see Astro's
      // `transitions/router.js`) AND every subsequent client-side
      // navigation. Keeping a second, independent auto-init source would
      // double-bind every listener on the very first load already, which is
      // not "idempotent" for `click-tracking`: two listeners on one
      // `[data-track]` node fire `trackEvent()` twice per click, directly
      // violating "no duplicate Umami events" (spec: "analytics-events").
      // Centralizing on one disconnect-then-reinit owner avoids that for
      // every module, including the persisted header's CTA.
      let disconnectFns: Array<() => void> = [];

      function reinitMotionModules(): void {
        for (const disconnect of disconnectFns) {
          disconnect();
        }
        disconnectFns = [initScrollReveal(), initHeaderScroll(), initFaqAnimation(), initClickTracking()];
      }

      document.addEventListener("astro:page-load", reinitMotionModules);
    </script>
  </body>
</html>
