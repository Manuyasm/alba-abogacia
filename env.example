# Cap (self-hosted CAPTCHA) — see AGENTS.md §9 and docker-compose.yml
# CAP_API_URL is the Astro app's own (server-side) view of the Cap instance,
# used only for the /siteverify call in src/pages/api/contacto.ts.
CAP_API_URL=http://localhost:3000
# PUBLIC_CAP_API_URL is the browser's view of the same Cap instance, used only
# by the client-side widget (src/components/contact/ContactForm.tsx) to mount
# <cap-widget data-cap-api-endpoint>. In local dev this is the same host:port
# as CAP_API_URL; in production it must point to the public, HTTPS-only,
# reverse-proxied Cap endpoint (never the internal Docker service name),
# per AGENTS.md §9 ("Publicar el endpoint solo mediante HTTPS").
PUBLIC_CAP_API_URL=http://localhost:3000
# PUBLIC_CAP_SITE_KEY / CAP_SECRET_KEY are created per-site in the Cap dashboard
# (see docker-compose.yml comments), not set directly on the Cap container.
PUBLIC_CAP_SITE_KEY=
CAP_SECRET_KEY=
# CAP_ADMIN_KEY is the Cap Standalone container's own dashboard/admin login
# (mapped to the `ADMIN_KEY` env var Cap itself reads) — never the same as CAP_SECRET_KEY.
CAP_ADMIN_KEY=
# CAP_CORS_ORIGIN restricts the Cap container's CORS_ORIGIN to the production domain(s)
# per AGENTS.md §9 ("Restringir CORS al dominio de producción"). Comma-separated if multiple.
CAP_CORS_ORIGIN=

# Umami (self-hosted analytics) — see AGENTS.md §10
PUBLIC_UMAMI_SCRIPT_URL=
PUBLIC_UMAMI_WEBSITE_ID=

# Contact form recipient — see AGENTS.md §8. Never hardcode; client must confirm the
# real address (see DESIGN.md §15 "Confirmar correo receptor del formulario").
CONTACT_RECIPIENT_EMAIL=

# Email retention period for delivered contact-form messages, in days.
# OPEN ITEM: value pending client confirmation — see spec "Open Items".
# Do not invent a number; leave unset until confirmed.
CONTACT_EMAIL_RETENTION_DAYS={{RETENTION_PERIOD}}

# Dev/E2E-only opt-in (see src/pages/api/contacto.ts resolveEmailTransport()).
# When exactly "true", swaps in an always-succeeding, never-delivers-anywhere
# test email transport so the PR5 Playwright suite can exercise the real
# POST /api/contacto pipeline through to a genuine success response against a
# live self-hosted Cap instance, without a real SMTP provider (still an open
# item above). MUST stay unset in production.
CONTACT_EMAIL_TEST_MODE=
